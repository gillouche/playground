package(default_visibility = ["//visibility:public"])

exports_files([
    "run_command.sh",
    "deploy_minikube.sh",
    "deploy_sandbox_all.sh",
    "sandbox_workflow.sh",
    "smart_push.sh",
    "ytt_gen.sh",
    "affected_targets.sh",
    "install_python_deps.sh",
])

# Python script wrappers - use system Python from Nix shell (with pyyaml)
sh_binary(
    name = "freeze",
    srcs = ["freeze.sh"],
    data = ["//tools/scripts/python:freeze.py"],
)

sh_binary(
    name = "promote",
    srcs = ["promote.sh"],
    data = ["//tools/scripts/python:promote.py"],
)

sh_binary(
    name = "sync_dev",
    srcs = ["sync_dev.sh"],
    data = [
        "//tools/scripts/python:sync_dev.py",
        "//:ca-bundle.pem",
    ],
)

sh_binary(
    name = "rollback",
    srcs = ["rollback.sh"],
    data = ["//tools/scripts/python:rollback.py"],
)

sh_binary(
    name = "determine_base_commit",
    srcs = ["determine_base_commit.sh"],
    data = [
        "//tools/scripts/python:determine_base_commit.py",
        "//:ca-bundle.pem",
    ],
)

sh_binary(
    name = "smart_push",
    srcs = ["smart_push.sh"],
    data = [":determine_base_commit"],
)

sh_binary(
    name = "gen_manifests",
    srcs = ["ytt_gen.sh"],
    tags = ["no-cache"],
)

sh_binary(
    name = "affected_targets",
    srcs = ["affected_targets.sh"],
    data = [":determine_base_commit"],
)
