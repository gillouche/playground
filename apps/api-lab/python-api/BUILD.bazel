load("@pip_apilab_python_api//:requirements.bzl", "requirement")
load("@pip_apilab_python_api_dev//:requirements.bzl", dev_requirement = "requirement")
load("//tools:python_defs.bzl", "python_application")

python_application(
    name = "python-api",
    srcs = glob(["src/**/*.py"]),
    integration_tests = glob(["tests/integration/**/*.py"]),
    test_args = [
        "-o",
        "asyncio_mode=auto",
    ],
    test_deps = [
        dev_requirement("pytest"),
        dev_requirement("pytest-asyncio"),
        dev_requirement("pytest-cov"),
        dev_requirement("httpx"),
        dev_requirement("bandit"),
    ],
    unit_tests = glob(["tests/unit/**/*.py"]),
    deps = [
        requirement("fastapi"),
        requirement("pydantic"),
        requirement("pydantic-settings"),
        requirement("uvicorn"),
        requirement("sqlalchemy"),
        requirement("asyncpg"),
        requirement("redis"),
        requirement("alembic"),
        requirement("strawberry-graphql"),
        requirement("grpcio"),
        requirement("grpcio-tools"),
        requirement("grpcio-reflection"),
        requirement("protobuf"),
        requirement("prometheus-fastapi-instrumentator"),
        requirement("prometheus-client"),
        requirement("opentelemetry-api"),
        requirement("opentelemetry-sdk"),
        requirement("opentelemetry-instrumentation-fastapi"),
        requirement("opentelemetry-exporter-otlp"),
        requirement("tenacity"),
        requirement("structlog"),
    ],
)

# NOTE: Lint (ruff) and security scan (bandit) are handled by pre-commit hooks.
# Native binary tools like ruff don't integrate well with rules_python py_test
# because the binary isn't exposed in Bazel runfiles.

# Export lockfiles for MODULE.bazel pip.parse
exports_files([
    "requirements.in",
    "requirements_lock.txt",
    "requirements_dev.in",
    "requirements_dev_lock.txt",
])
