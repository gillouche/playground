        {
          "expr": "sum by (pod) (rate(container_cpu_usage_seconds_total{namespace=~\"playground-apps.*api-lab\"}[5m])) / sum by (pod) (kube_pod_container_resource_limits{namespace=~\"playground-apps.*api-lab\", resource=\"cpu\"})",
          "legendFormat": "{{ pod }}",
          "refId": "A"
