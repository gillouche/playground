# Bazel Remote Cache Configuration
# Reference: https://bazel.build/remote/caching

# Remote HTTP Cache (for SeaweedFS S3-compatible storage)
# Uncomment and configure when SeaweedFS is ready
# build --remote_cache=https://seaweedfs.gillouche.homelab/bazel-cache
# build --remote_upload_local_results=true
# build --remote_timeout=60s

# Local disk cache (fallback for dev)
build --disk_cache=~/.cache/bazel/disk_cache

# Common flags
build --remote_cache_compression
build --remote_accept_cached=true

# SSL/TLS configuration for internal Nexus proxy
# The CA bundle env vars are set by the nix shell (default and CI)
# Bazel's JVM truststore is configured via .bazelrc.ci (generated by CI shell)
build --action_env=SSL_CERT_FILE
build --repo_env=SSL_CERT_FILE

# CI-specific startup options (generated by Nix CI shell, not committed)
try-import %workspace%/.bazelrc.ci

# CI-specific config (use with --config=ci)
# Credentials will be provided via environment variables:
# AWS_ACCESS_KEY_ID and AWS_SECRET_ACCESS_KEY
# Start with internal S3 endpoint which supports AWS V4 signatures
build:ci --remote_cache=http://bazel-remote-cache.seaweedfs.svc.cluster.local:8080
build:ci --remote_upload_local_results=true
build:ci --remote_cache_async
build:ci --remote_local_fallback

# Parallelism and resource settings for CI
build:ci --jobs=auto
build:ci --local_resources=memory=HOST_RAM*.8
test:ci --test_output=errors

# Platform configurations for cross-compilation
# ARM64 for Raspberry Pi deployment
build:arm64 --platforms=//tools/platforms:linux_arm64

# AMD64 for local testing on x86_64
build:amd64 --platforms=//tools/platforms:linux_amd64
