__pycache__/
*.pyc
*.pyo
*.pyd
*.egg-info/
.eggs/
dist/
build/
**/.venv
**/.coverage
.mypy_cache/
.pytest_cache/
.ruff_cache/
.tox/
.nox/
htmlcov/
coverage.xml

# Go
vendor/

# Rust
**/target/

