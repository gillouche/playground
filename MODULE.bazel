bazel_dep(name = "rules_python", version = "1.8.0")
bazel_dep(name = "rules_oci", version = "2.2.7")
bazel_dep(name = "rules_pkg", version = "1.2.0")
bazel_dep(name = "platforms", version = "1.0.0")

# Go support - uses host Go from Nix
bazel_dep(name = "rules_go", version = "0.50.1")
bazel_dep(name = "gazelle", version = "0.40.0")

# Rust support - uses host Rust from Nix
bazel_dep(name = "rules_rust", version = "0.56.0")

# TypeScript/JavaScript support - uses host Node.js from Nix
bazel_dep(name = "aspect_rules_js", version = "2.9.2")
bazel_dep(name = "aspect_rules_ts", version = "3.3.1")
bazel_dep(name = "rules_nodejs", version = "6.3.0")

# Python toolchain - uses host Python from Nix
python = use_extension("@rules_python//python/extensions:python.bzl", "python")
python.toolchain(
    python_version = "3.12",
    is_default = True,
)
use_repo(python, "python_3_12")

# pip.parse for hermetic Python dependencies
pip = use_extension("@rules_python//python/extensions:pip.bzl", "pip")

# Greeting Service dependencies
pip.parse(
    hub_name = "pip_greeting_service",
    python_version = "3.12",
    requirements_by_platform = {
        "//apps/demo-app/greeting-service:requirements_lock.txt": "linux_aarch64,linux_x86_64,osx_aarch64",
    },
    experimental_index_url = "https://pypi.org/simple",
)

# Greeting Service dev dependencies (for tests)
pip.parse(
    hub_name = "pip_greeting_service_dev",
    python_version = "3.12",
    requirements_by_platform = {
        "//apps/demo-app/greeting-service:requirements_dev_lock.txt": "linux_aarch64,linux_x86_64,osx_aarch64",
    },
    experimental_index_url = "https://pypi.org/simple",
)

# Infra Check Service dependencies
pip.parse(
