# OCI base images - multi-platform (ARM64 for Raspberry Pi, AMD64 for local testing)
oci = use_extension("@rules_oci//oci:extensions.bzl", "oci")
oci.pull(
    name = "python_base",
    image = "nexus.gillouche.homelab/docker-hosted/base/python-distroless",
    platforms = [
        "linux/arm64",
        "linux/amd64",
    ],
    tag = "3.14.3",
    digest = "sha256:d038e8b154baa570aae0ba229e4efddf721f07614912bcead57e83fcc717c684",
)
use_repo(oci, "python_base", "python_base_linux_arm64", "python_base_linux_amd64")

# Go distroless base for Go services (smaller, more secure)
oci.pull(
    name = "go_base",
    image = "nexus.gillouche.homelab/docker-hosted/base/go-distroless",
    platforms = [
        "linux/arm64",
        "linux/amd64",
    ],
    tag = "1.26.0",
    digest = "sha256:e0863cc5a7dd7da4f17d0353dc573b53645ff761aceeec873211d05cad23e85a",
)
use_repo(oci, "go_base", "go_base_linux_arm64", "go_base_linux_amd64")

# TypeScript/Node runtime distroless base (Node.js LTS, no build toolchain)
oci.pull(
    name = "typescript_base",
    image = "nexus.gillouche.homelab/docker-hosted/base/typescript-distroless",
    platforms = [
        "linux/arm64",
        "linux/amd64",
    ],
    tag = "24.14.0",
    digest = "sha256:03a2d9ccace5baa23560285afdff3015c5ca31fb681f7e463cf6ed899f6c82ec",
)
use_repo(oci, "typescript_base", "typescript_base_linux_arm64", "typescript_base_linux_amd64")

# Rust runtime distroless base (glibc runtime, no build toolchain)
oci.pull(
    name = "rust_base",
    image = "nexus.gillouche.homelab/docker-hosted/base/rust-distroless",
    platforms = [
        "linux/arm64",
        "linux/amd64",
    ],
    tag = "1.94.0",
    digest = "sha256:1e397f3326d4e9859952d4b2b5908fd186737545e5b605b4916c7bc5c19a59b9",
)
use_repo(oci, "rust_base", "rust_base_linux_arm64", "rust_base_linux_amd64")

# Go SDK - hermetic download (no host Go needed)
go_sdk = use_extension("@rules_go//go:extensions.bzl", "go_sdk")
go_sdk.download(version = "1.24.13")

# Go third-party dependencies (managed by gazelle)
go_deps = use_extension("@gazelle//:extensions.bzl", "go_deps")
go_deps.from_file(go_mod = "//apps/api-lab/go-api:go.mod")
use_repo(go_deps, "com_github_google_uuid")

# Rust toolchain - hermetic download (no host Rust needed)
rust = use_extension("@rules_rust//rust:extensions.bzl", "rust")
rust.toolchain(
    edition = "2021",
    versions = ["1.84.1"],
)

# Node.js toolchain - uses downloaded version for TypeScript support
node = use_extension("@rules_nodejs//nodejs:extensions.bzl", "node")
node.toolchain(
    name = "nodejs",
    node_version = "22.12.0",
)
