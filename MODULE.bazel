bazel_dep(name = "rules_python", version = "1.8.0")
bazel_dep(name = "rules_oci", version = "2.2.7")
bazel_dep(name = "rules_pkg", version = "1.2.0")
bazel_dep(name = "platforms", version = "1.0.0")

python = use_extension("@rules_python//python/extensions:python.bzl", "python")
python.toolchain(
    python_version = "3.13",
)
use_repo(python, "python_3_13")

oci = use_extension("@rules_oci//oci:extensions.bzl", "oci")
oci.pull(
    name = "distroless_python",
    image = "cgr.dev/chainguard/python",
    platforms = [
        "linux/amd64",
        "linux/arm64",
    ],
    digest = "sha256:6252e33e2d954d5d4188e68c8268545baa5e05d47f62d9bec295e5cc063bd07f",
)
use_repo(oci, "distroless_python", "distroless_python_linux_amd64", "distroless_python_linux_arm64")
