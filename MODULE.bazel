use_repo(
    pip,
    "pip_greeting_service",
    "pip_greeting_service_dev",
    "pip_infra_check_service",
    "pip_infra_check_service_dev",
    "pip_traffic_generator_service",
    "pip_traffic_generator_service_dev",
)

# OCI base images - multi-platform (ARM64 for Raspberry Pi, AMD64 for local testing)
oci = use_extension("@rules_oci//oci:extensions.bzl", "oci")
oci.pull(
    name = "python_base",
    image = "nexus.gillouche.homelab/docker-hosted/base/python-distroless",
    platforms = [
        "linux/arm64",
        "linux/amd64",
    ],
    tag = "3.12.12",
    digest = "sha256:bde394732e0bc073d0581c810cd262f4b71285947ab1386ce58896051383f675",
)
use_repo(oci, "python_base", "python_base_linux_arm64", "python_base_linux_amd64")

# Distroless base for future Go/Rust services (smaller, more secure)
oci.pull(
    name = "distroless_base",
    image = "gcr.io/distroless/base-debian12",
    platforms = [
        "linux/arm64",
        "linux/amd64",
    ],
    tag = "nonroot",
)
use_repo(oci, "distroless_base", "distroless_base_linux_arm64", "distroless_base_linux_amd64")

# Go SDK - uses host Go from Nix
go_sdk = use_extension("@rules_go//go:extensions.bzl", "go_sdk")
go_sdk.host()

# Rust toolchain - uses host Rust from Nix
rust = use_extension("@rules_rust//rust:extensions.bzl", "rust")
rust.toolchain(
    edition = "2021",
    versions = [],
)

# Node.js toolchain - uses downloaded version for TypeScript support
node = use_extension("@rules_nodejs//nodejs:extensions.bzl", "node")
node.toolchain(
    name = "nodejs",
    node_version = "22.12.0",
)
