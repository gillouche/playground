# Traffic Generator Service dev dependencies (for tests)
pip.parse(
    hub_name = "pip_traffic_generator_service_dev",
    python_version = "3.12",
    requirements_by_platform = {
        "//apps/demo-app/traffic-generator-service:requirements_dev_lock.txt": "linux_aarch64,linux_x86_64,osx_aarch64",
    },
