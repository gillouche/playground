bazel_dep(name = "rules_python", version = "2.0.2")
bazel_dep(name = "rules_oci", version = "2.3.0")
bazel_dep(name = "rules_pkg", version = "1.2.0")
bazel_dep(name = "platforms", version = "1.0.0")

# Go support - uses host Go from Nix
bazel_dep(name = "rules_go", version = "0.60.0")
bazel_dep(name = "gazelle", version = "0.50.0")

# Rust support - uses host Rust from Nix
bazel_dep(name = "rules_rust", version = "0.69.0")

# TypeScript/JavaScript support - uses host Node.js from Nix
bazel_dep(name = "aspect_rules_js", version = "3.0.3")
bazel_dep(name = "aspect_rules_ts", version = "3.8.10")
bazel_dep(name = "rules_nodejs", version = "6.7.4")

# Python toolchain - uses host Python from Nix
python = use_extension("@rules_python//python/extensions:python.bzl", "python")
python.toolchain(
    python_version = "3.14",
    is_default = True,
)
use_repo(python, "python_3_14")

# pip.parse for hermetic Python dependencies
pip = use_extension("@rules_python//python/extensions:pip.bzl", "pip")

# Greeting Service dependencies
pip.parse(
    hub_name = "pip_greeting_service",
    python_version = "3.14",
    target_platforms = [
        "linux_aarch64",
        "linux_x86_64",
        "osx_aarch64",
    ],
    requirements_by_platform = {
        "//apps/demo-app/greeting-service:requirements_lock.txt": "linux_aarch64,linux_x86_64,osx_aarch64",
    },
    experimental_index_url = "https://nexus.gillouche.homelab/repository/pypi-proxy/simple",
)

