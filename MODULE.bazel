    python_version = "3.12",
    requirements_by_platform = {
        "//apps/demo-app/infra-check-service:requirements_lock.txt": "linux_aarch64,linux_x86_64,osx_aarch64",
    },
    experimental_index_url = "https://pypi.org/simple",
)

# Infra Check Service dev dependencies (for tests)
pip.parse(
    hub_name = "pip_infra_check_service_dev",
    python_version = "3.12",
    requirements_by_platform = {
        "//apps/demo-app/infra-check-service:requirements_dev_lock.txt": "linux_aarch64,linux_x86_64,osx_aarch64",
